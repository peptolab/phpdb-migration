{
    "name": "peptolab/phpdb-migration",
    "description": "Idempotent database migration engine for php-db/phpdb.",
    "license": "BSD-3-Clause",
    "keywords": [
        "phpdb",
        "database",
        "migration",
        "schema"
    ],
    "homepage": "https://github.com/peptolab/phpdb-migration",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/peptolab/phpdb-migration/issues",
        "source": "https://github.com/peptolab/phpdb-migration"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laminas": {
            "config-provider": "PhpDb\\Migration\\ConfigProvider"
        }
    },
    "require": {
        "php": "^8.3",
        "php-db/phpdb": "^0.6.0",
        "symfony/console": "^6.0 || ^7.0"
    },
    "require-dev": {
        "php-db/phpdb-mysql": "0.5.x-dev",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "laminas/laminas-servicemanager": "For container-based factory integration (^3.0 || ^4.0)",
        "laminas/laminas-cli": "For CLI command integration"
    },
    "autoload": {
        "psr-4": {
            "PhpDb\\Migration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpDbTest\\Migration\\Asset\\": "test/asset/",
            "PhpDbTest\\Migration\\": "test/unit/",
            "PhpDbIntegrationTest\\Migration\\": "test/integration/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
